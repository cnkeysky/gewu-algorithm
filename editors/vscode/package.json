{
  "name": "gewu-algorithm",
  "version": "0.1.7",
  "private": true,
  "publisher": "cnkeysky",
  "displayName": "GEWU Algorithm",
  "description": "Offline deliberate algorithm practice through the GEWU Rust core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cnkeysky/gewu-algorithm.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "main": "./dist/src/extension.js",
  "extensionKind": ["workspace"],
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:gewuAlgorithm.startShadowTyping",
    "onCommand:gewuAlgorithm.startCodeRecall",
    "onCommand:gewuAlgorithm.revealCodeRecallPrompt",
    "onCommand:gewuAlgorithm.startFlowRecall",
    "onCommand:gewuAlgorithm.submitFlowRecall",
    "onCommand:gewuAlgorithm.revealFlowPrompt",
    "onCommand:gewuAlgorithm.resumePractice",
    "onCommand:gewuAlgorithm.discardCheckpoint",
    "onCommand:gewuAlgorithm.showHistory",
    "onCommand:gewuAlgorithm.deleteHistory",
    "onCommand:gewuAlgorithm.stopShadowTyping",
    "onCommand:gewuAlgorithm.stopPractice",
    "onCommand:gewuAlgorithm.restartPractice"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gewuAlgorithm.startShadowTyping",
        "title": "GEWU: Start Shadow Typing"
      },
      { "command": "gewuAlgorithm.startCodeRecall", "title": "GEWU: Start Code Recall" },
      { "command": "gewuAlgorithm.revealCodeRecallPrompt", "title": "GEWU: Reveal Code Recall Prompt" },
      { "command": "gewuAlgorithm.startFlowRecall", "title": "GEWU: Start Flow Recall" },
      { "command": "gewuAlgorithm.submitFlowRecall", "title": "GEWU: Submit Flow Recall Answer" },
      { "command": "gewuAlgorithm.revealFlowPrompt", "title": "GEWU: Reveal Flow Recall Prompt" },
      { "command": "gewuAlgorithm.resumePractice", "title": "GEWU: Resume Interrupted Practice" },
      { "command": "gewuAlgorithm.discardCheckpoint", "title": "GEWU: Discard Interrupted Practice" },
      { "command": "gewuAlgorithm.showHistory", "title": "GEWU: Show Recent Attempts" },
      { "command": "gewuAlgorithm.deleteHistory", "title": "GEWU: Delete Practice Attempts" },
      {
        "command": "gewuAlgorithm.stopShadowTyping",
        "title": "GEWU: Stop Shadow Typing"
      },
      { "command": "gewuAlgorithm.stopPractice", "title": "GEWU: Stop Practice" },
      { "command": "gewuAlgorithm.restartPractice", "title": "GEWU: Restart Practice" }
    ],
    "configuration": {
      "title": "GEWU Algorithm",
      "properties": {
        "gewuAlgorithm.cargoPath": { "type": "string", "default": "cargo", "description": "Path to the Rust cargo executable used by the local development core." }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --check src test",
    "format:write": "prettier --write src test",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node dist/test/interaction.js && node dist/test/core-session.js && node dist/test/checkpoints.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
