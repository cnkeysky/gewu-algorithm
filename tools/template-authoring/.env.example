# Selection only. Never put a real secret in this file.
GEWU_LLM_PROVIDER=deepseek
GEWU_LLM_MODEL=deepseek-v4-flash
GEWU_LLM_MAX_TOKENS=8192
GEWU_LLM_TIMEOUT_MS=60000
GEWU_LLM_MAX_ATTEMPTS=2
GEWU_LLM_MAX_STRUCTURED_ATTEMPTS=2

# Pi-ai reads the provider credential from the process environment.
# DEEPSEEK_API_KEY=
