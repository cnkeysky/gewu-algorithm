# Selection only. Never put a real secret in this file.
GEWU_LLM_PROVIDER=deepseek
GEWU_LLM_MODEL=deepseek-v4-flash
GEWU_LLM_MAX_TOKENS=16384
GEWU_LLM_TIMEOUT_MS=120000
GEWU_LLM_MAX_ATTEMPTS=2
GEWU_LLM_MAX_STRUCTURED_ATTEMPTS=3
# Tool selection for structured generation: "forced" (default) pins the tool
# call; "auto" lets the model decide and is required for reasoning-mode relays
# that reject forced tool_choice; "required" sends the plain string
# `tool_choice: "required"` for OpenAI-compatible relays that reject the
# forced function object. The relay provider defaults to "auto".
# GEWU_LLM_TOOL_CHOICE=auto
# Reasoning effort injected into relay requests. The relay provider defaults
# to "none" because reasoning-mode gateways often ignore thinking-disabled
# flags; set e.g. "low"/"medium"/"high" to re-enable thinking.
# GEWU_LLM_REASONING_EFFORT=none

# Optional: route requests through an OpenAI-compatible relay/proxy endpoint.
# Set GEWU_LLM_PROVIDER=relay, GEWU_LLM_MODEL=<relay model id>, and the
# endpoint base URL below; the relay key goes in GEWU_LLM_API_KEY (provider
# keys like DEEPSEEK_API_KEY are never sent to a relay). The wire protocol
# follows the entry's `wireApi` in providers.json: "responses" (default for
# Codex-style gateways, e.g. the built-in relay entry) appends /responses,
# "chat" appends /chat/completions.
# Relay providers are declared in providers.json (key-value mapping: id ->
# { label, keyEnv, baseUrlEnv, wireApi, opencodeHeaders }); add a named relay
# there, then set its env vars — no code changes required. `opencodeHeaders`
# adds x-opencode-session / x-opencode-request headers recommended by some
# Codex-style gateways.
# GEWU_LLM_BASE_URL=https://api.example.com/v1
# GEWU_LLM_API_KEY=
# Optional explicit proxy for relay transport. When set, both http and https
# relay requests go through it; otherwise HTTPS_PROXY / HTTP_PROXY are honored
# (NO_PROXY applies either way). Without any proxy configured, requests
# connect directly. Set GEWU_LLM_PROXY=off (or none/direct) to force a direct
# connection even when HTTPS_PROXY / HTTP_PROXY are present.
# GEWU_LLM_PROXY=http://127.0.0.1:7890

# Optional generic-key fallback: with GEWU_LLM_KEY_FALLBACK=1, a built-in
# provider whose own key env var is unset (e.g. XIAOMI_TOKEN_PLAN_CN_API_KEY
# for xiaomi-token-plan-cn) falls back to GEWU_LLM_API_KEY, so one key var can
# back several providers. Providers not in the alias table keep their own key
# env var only.
# GEWU_LLM_KEY_FALLBACK=1

# Built-in providers (deepseek, openai, moonshotai, xiaomi, and everything
# Pi-ai ships) are derived from the Pi package — ids, labels, models, and key
# env conventions come from Pi, so vendor changes are handled by updating Pi.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# XIAOMI_API_KEY=
# XIAOMI_TOKEN_PLAN_CN_API_KEY=  # Pi built-in: Xiaomi MiMo token-plan (CN), model ids mimo-v2-pro / mimo-v2.5 / mimo-v2.5-pro
