# Selection only. Never put a real secret in this file.
GEWU_LLM_PROVIDER=deepseek
GEWU_LLM_MODEL=deepseek-v4-flash
GEWU_LLM_MAX_TOKENS=16384
GEWU_LLM_TIMEOUT_MS=120000
GEWU_LLM_MAX_ATTEMPTS=2
GEWU_LLM_MAX_STRUCTURED_ATTEMPTS=3
# Tool selection for structured generation: "forced" (default) pins the tool
# call; "auto" lets the model decide and is required for reasoning-mode relays
# that reject forced tool_choice. The relay provider defaults to "auto".
# GEWU_LLM_TOOL_CHOICE=auto
# Reasoning effort injected into relay requests. The relay provider defaults
# to "none" because reasoning-mode gateways often ignore thinking-disabled
# flags; set e.g. "low"/"medium"/"high" to re-enable thinking.
# GEWU_LLM_REASONING_EFFORT=none

# Optional: route requests through an OpenAI-compatible relay/proxy endpoint.
# Set GEWU_LLM_PROVIDER=relay, GEWU_LLM_MODEL=<relay model id>, and the
# endpoint base URL below; the relay key goes in GEWU_LLM_API_KEY
# (DEEPSEEK_API_KEY is also accepted for the relay). The OpenAI SDK appends
# /chat/completions to the base URL.
# GEWU_LLM_BASE_URL=https://api.example.com/v1
# GEWU_LLM_API_KEY=

# Pi-ai reads the provider credential from the process environment.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# XIAOMI_API_KEY=
