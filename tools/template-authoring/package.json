{
  "name": "@gewu/template-authoring",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "smoke": "npm run build && node dist/smoke.js",
    "smoke:local": "npm run build && node --env-file=.env.local dist/smoke.js",
    "generate-template": "npm run build && node dist/generate-template.js",
    "generate-template:local": "npm run build && node --env-file=.env.local dist/generate-template.js",
    "review-template": "npm run build && node dist/review-template.js",
    "review-template:local": "npm run build && node --env-file=.env.local dist/review-template.js",
    "rule-dedup": "npm run build && node dist/rule-dedup.js",
    "workbench:api": "npm run build && node dist/workbench-api.js",
    "workbench:api:local": "npm run build && node --env-file=.env.local dist/workbench-api.js",
    "workbench:core": "mkdir -p drafts/.workbench/published && cargo run -p gewu-cli -- serve --content-root ../../fixtures/algorithm-units/valid --content-root drafts/.workbench/published --data-root ../../.gewu-data",
    "workbench:dev": "npm --prefix workbench run dev",
    "workbench:build": "npm --prefix workbench run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
