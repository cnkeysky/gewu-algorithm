{
  "name": "@gewu/template-authoring",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "smoke": "npm run build && node dist/smoke.js",
    "smoke:local": "npm run build && node --env-file=.env.local dist/smoke.js",
    "generate-template": "npm run build && node dist/generate-template.js",
    "generate-template:local": "npm run build && node --env-file=.env.local dist/generate-template.js",
    "review-template": "npm run build && node dist/review-template.js",
    "review-template:local": "npm run build && node --env-file=.env.local dist/review-template.js",
    "fetch:hot100": "node scripts/fetch-hot100.mjs",
    "stamp:published": "node scripts/stamp-published.mjs",
    "units:pack": "node scripts/units-pack.mjs",
    "units:fetch": "node scripts/units-fetch.mjs",
    "drafts:export": "node scripts/drafts-export.mjs",
    "drafts:import": "node scripts/drafts-import.mjs",
    "batch": "npm run build && node dist/batch-authoring.js",
    "rule-dedup": "npm run build && node dist/rule-dedup.js",
    "workbench:api": "npm run build && node dist/workbench-api.js",
    "workbench:api:local": "npm run build && node --env-file=.env.local dist/workbench-api.js",
    "workbench:core": "mkdir -p drafts/.workbench/published && cargo run -p gewu-cli -- serve --content-root ../../fixtures/algorithm-units/valid --content-root drafts/.workbench/published --published-root drafts/.workbench/published --data-root ../../.gewu-data",
    "workbench:dev": "npm --prefix workbench run dev",
    "workbench:build": "npm --prefix workbench run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "turndown": "^7.2.4",
    "typescript": "^5.8.3"
  }
}
